# Copy this file to ".env" and fill in your Supabase values.
# Get them in Supabase: Project Settings -> API.
# The .env file is git-ignored and never committed.
#
# After editing, run:  node build.js   (regenerates js/config.js)

SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# For natural pronunciation audio (see AUDIO.md). Used only by gen-audio.js
# at generation time — never shipped to the browser.
GOOGLE_TTS_API_KEY=your-google-cloud-tts-api-key
# Optional overrides:
# TTS_VOICE=de-DE-Neural2-F
# TTS_RATE=0.95
